{
  "id": "vault-tools",
  "name": "Vault Tools",
  "description": "Safe OpenClaw tools for HashiCorp Vault KV v2 metadata, redacted reads, guarded writes, and ExternalSecret diagnostics.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "vaultAddr": {
        "type": "string",
        "description": "Vault base URL. Falls back to VAULT_ADDR."
      },
      "mount": {
        "type": "string",
        "default": "secret"
      },
      "engineVersion": {
        "type": "string",
        "enum": [
          "v2"
        ],
        "default": "v2"
      },
      "authMode": {
        "type": "string",
        "enum": [
          "kubernetes",
          "token",
          "none"
        ],
        "default": "kubernetes"
      },
      "kubernetesMountPath": {
        "type": "string",
        "default": "kubernetes"
      },
      "kubernetesRole": {
        "type": "string",
        "default": "openclaw-vault-tools"
      },
      "kubernetesJwtPath": {
        "type": "string",
        "default": "/var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "tokenFile": {
        "type": "string"
      },
      "tokenEnv": {
        "type": "string",
        "default": "VAULT_TOKEN"
      },
      "kubectlBin": {
        "type": "string",
        "default": "kubectl"
      },
      "defaultNamespace": {
        "type": "string",
        "default": "default"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "default": 15000
      },
      "allowReveal": {
        "type": "boolean",
        "default": true
      },
      "allowWrite": {
        "type": "boolean",
        "default": true
      },
      "readValueMaxChars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576,
        "default": 131072
      }
    }
  },
  "contracts": {
    "tools": [
      "vault_status",
      "vault_list_paths",
      "vault_secret_metadata",
      "vault_secret_keys",
      "vault_secret_read",
      "vault_secret_write",
      "vault_external_secret_status",
      "vault_render_externalsecret",
      "vault_map_consumers",
      "vault_capabilities"
    ],
    "commands": []
  }
}
